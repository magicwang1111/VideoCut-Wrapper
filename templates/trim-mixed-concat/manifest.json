{
  "id": "trim-mixed-concat",
  "name": "混合转场拼接",
  "description": "剪去每段开头指定秒数，每个连接点可独立指定转场类型（flash-black 闪黑 / dissolve 叠化 / cut 直切），输出为单一视频，不额外添加音乐或字幕",
  "version": "1.0.0",
  "author": "VideoCut Wrapper",
  "entry": "src/project.ts",
  "variables": {
    "clip_1": {
      "type": "video",
      "label": "第 1 段视频",
      "required": true
    },
    "clip_2": {
      "type": "video",
      "label": "第 2 段视频"
    },
    "clip_3": {
      "type": "video",
      "label": "第 3 段视频"
    },
    "clip_4": {
      "type": "video",
      "label": "第 4 段视频"
    },
    "clip_5": {
      "type": "video",
      "label": "第 5 段视频"
    },
    "clip_6": {
      "type": "video",
      "label": "第 6 段视频"
    },
    "trim_start": {
      "type": "number",
      "label": "剪去开头（秒）",
      "default": 2,
      "min": 0,
      "max": 30
    },
    "transition_1": {
      "type": "select",
      "options": ["flash-black", "dissolve", "cut"],
      "label": "第 1 个转场（clip1→clip2）：flash-black / dissolve / cut",
      "default": "flash-black"
    },
    "transition_2": {
      "type": "select",
      "options": ["flash-black", "dissolve", "cut"],
      "label": "第 2 个转场（clip2→clip3）：flash-black / dissolve / cut",
      "default": "dissolve"
    },
    "transition_3": {
      "type": "select",
      "options": ["flash-black", "dissolve", "cut"],
      "label": "第 3 个转场（clip3→clip4）：flash-black / dissolve / cut",
      "default": "flash-black"
    },
    "transition_4": {
      "type": "select",
      "options": ["flash-black", "dissolve", "cut"],
      "label": "第 4 个转场（clip4→clip5）：flash-black / dissolve / cut",
      "default": "dissolve"
    },
    "transition_5": {
      "type": "select",
      "options": ["flash-black", "dissolve", "cut"],
      "label": "第 5 个转场（clip5→clip6）：flash-black / dissolve / cut",
      "default": "flash-black"
    },
    "transition_duration": {
      "type": "number",
      "label": "转场时长（秒）",
      "default": 0.5,
      "min": 0.1,
      "max": 2.0
    }
  },
  "tags": ["基础", "拼接", "转场", "混合", "剪头"]
}
