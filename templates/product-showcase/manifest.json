{
  "id": "product-showcase",
  "name": "产品展示",
  "description": "3 场景产品展示模板，含 Logo 叠加、字幕和背景音乐",
  "version": "1.0.0",
  "author": "VideoCut Wrapper",
  "preset": "douyin_vertical",
  "entry": "src/project.ts",
  "variables": {
    "clip_intro": {
      "type": "video",
      "label": "开场视频",
      "required": true
    },
    "clip_detail": {
      "type": "video",
      "label": "产品特写",
      "required": true
    },
    "clip_outro": {
      "type": "video",
      "label": "结尾视频",
      "required": true
    },
    "product_name": {
      "type": "text",
      "label": "产品名称",
      "default": "产品名称"
    },
    "price_text": {
      "type": "text",
      "label": "价格文案",
      "default": "¥99"
    },
    "outro_text": {
      "type": "text",
      "label": "结尾文案",
      "default": "关注我们获取更多优惠"
    },
    "logo": {
      "type": "image",
      "label": "品牌 Logo"
    },
    "bgm": {
      "type": "audio",
      "label": "背景音乐"
    },
    "subtitle_color": {
      "type": "color",
      "label": "字幕颜色",
      "default": "#FFFFFF"
    },
    "intro_duration": {
      "type": "number",
      "label": "开场时长（秒）",
      "default": 3,
      "min": 1,
      "max": 10
    },
    "detail_duration": {
      "type": "number",
      "label": "特写时长（秒）",
      "default": 5,
      "min": 1,
      "max": 15
    },
    "outro_duration": {
      "type": "number",
      "label": "结尾时长（秒）",
      "default": 3,
      "min": 1,
      "max": 10
    },
    "enable_bgm": {
      "type": "boolean",
      "label": "启用背景音乐",
      "default": true
    },
    "enable_transition": {
      "type": "boolean",
      "label": "启用转场",
      "default": true
    },
    "bgm_volume": {
      "type": "number",
      "label": "背景音乐音量 (0-1)",
      "default": 0.3,
      "min": 0,
      "max": 1
    }
  },
  "tags": ["电商", "产品展示", "竖屏", "多层合成"]
}
