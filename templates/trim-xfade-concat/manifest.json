{
  "id": "trim-xfade-concat",
  "name": "裁头叠化拼接",
  "description": "裁去每段视频开头 N 秒后，用叠化（cross-dissolve）过渡顺序拼接，转场时长可配置，不额外添加音乐或字幕",
  "version": "1.0.0",
  "author": "Goumei",
  "entry": "src/project.ts",
  "variables": {
    "clip_1": {
      "type": "video",
      "label": "第 1 段视频",
      "required": true
    },
    "clip_2": {
      "type": "video",
      "label": "第 2 段视频"
    },
    "clip_3": {
      "type": "video",
      "label": "第 3 段视频"
    },
    "clip_4": {
      "type": "video",
      "label": "第 4 段视频"
    },
    "clip_5": {
      "type": "video",
      "label": "第 5 段视频"
    },
    "clip_6": {
      "type": "video",
      "label": "第 6 段视频"
    },
    "trim_start": {
      "type": "number",
      "label": "裁去开头（秒）",
      "default": 2,
      "min": 0,
      "max": 10
    },
    "transition_duration": {
      "type": "number",
      "label": "叠化时长（秒）",
      "default": 1,
      "min": 0.1,
      "max": 3.0
    }
  },
  "tags": ["基础", "拼接", "转场", "叠化", "裁剪"]
}
