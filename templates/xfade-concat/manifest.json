{
  "id": "xfade-concat",
  "name": "叠化拼接",
  "description": "将多个视频按顺序拼接，前一段尾部淡出、下一段首帧静帧垫底，长度不足时自动复制边缘帧创建转场，不额外添加音乐或字幕",
  "version": "1.0.0",
  "author": "Goumei",
  "entry": "src/project.ts",
  "variables": {
    "clip_1": {
      "type": "video",
      "label": "第 1 段视频",
      "required": true
    },
    "clip_2": {
      "type": "video",
      "label": "第 2 段视频"
    },
    "clip_3": {
      "type": "video",
      "label": "第 3 段视频"
    },
    "clip_4": {
      "type": "video",
      "label": "第 4 段视频"
    },
    "clip_5": {
      "type": "video",
      "label": "第 5 段视频"
    },
    "clip_6": {
      "type": "video",
      "label": "第 6 段视频"
    },
    "transition_duration": {
      "type": "number",
      "label": "转场时长（秒）",
      "default": 0.5,
      "min": 0.1,
      "max": 3.0
    }
  },
  "tags": ["基础", "拼接", "转场", "叠化"]
}
