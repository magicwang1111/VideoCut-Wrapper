# Copy this file to .env before running locally or in Docker.
# Existing process / Docker environment variables take precedence over this file.
# All paths below are Linux container paths, not Windows host paths.
# The provided docker-compose.yml mounts host folders to these in-container paths.

# ------------------------------------------------------------------------------
# Server
# ------------------------------------------------------------------------------

# The HTTP port exposed by the container and used by the serve command.
PORT=3000

# Business image base image tag. Build docker/base/Dockerfile into this tag first.
BASE_IMAGE=magicwang/pytorch-base:torch210-cu128-runtime-v1

# Business image tag and inspectable build description.
# Example: IMAGE_TAG=v1, IMAGE_DESCRIPTION=GPU NVENC Docker packaging fix.
IMAGE_TAG=latest
IMAGE_DESCRIPTION=VideoCut Wrapper image

# Comma-separated API keys accepted by the X-Api-Key header.
# Change this before deployment.
API_KEYS=change-me

# Application log level: DEBUG / INFO / WARNING / ERROR.
LOG_LEVEL=INFO

# Container timezone. Requires tzdata in the image.
TZ=Asia/Shanghai

# ------------------------------------------------------------------------------
# FFmpeg
# ------------------------------------------------------------------------------

# Leave these blank inside Docker. The image installs ffmpeg / ffprobe to PATH.
FFMPEG_PATH=
FFPROBE_PATH=

# Default to auto: try GPU encoders first, then fall back to libx264.
# Use docker-compose.gpu.yml on GPU hosts to expose NVIDIA devices.
FFMPEG_ENCODER=auto

# Optional hardware decode hint such as cuda. Leave blank for CPU mode.
FFMPEG_HWACCEL=

# ------------------------------------------------------------------------------
# Storage mode
# ------------------------------------------------------------------------------

# Choose ONE storage mode:
# 1) Real OSS:
#    - set OSS_ENDPOINT / OSS_ACCESS_KEY_ID / OSS_ACCESS_KEY_SECRET / OSS_BUCKET
#    - leave OSS_LOCAL_ROOT empty
#    - keep SYNC_BGM_ON_STARTUP=1 and SYNC_BGM_TEMPLATE_ON_STARTUP=1
#      if you want to sync BGM from OSS at startup
# 2) Local OSS for single-host testing:
#    - set OSS_LOCAL_ROOT=/srv/videocut/oss-local
#    - OSS credentials can stay empty
#    - set SYNC_BGM_ON_STARTUP=0 and SYNC_BGM_TEMPLATE_ON_STARTUP=0
#      unless you still want to pull BGM from real OSS

# Use the public endpoint for normal internet-facing Linux hosts.
# The internal endpoint only works inside an Alibaba Cloud VPC.
OSS_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

# Public endpoint used to build downloadable /bgm ossUrl and task outputUrl values.
OSS_PUBLIC_ENDPOINT=oss-cn-hangzhou.aliyuncs.com

OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_STS_TOKEN=
OSS_BUCKET=goumee-coze
OSS_PREFIX=GouMei-Video-Cut

# Output upload backend. Default uses ossutil64 for faster OSS uploads.
# Set OSS_UPLOAD_BACKEND=oss2 only if you need to force the Python SDK path.
OSS_UPLOAD_BACKEND=ossutil
OSSUTIL_PATH=ossutil64
OSSUTIL_TIMEOUT_SECONDS=600

# Example local mode:
# OSS_LOCAL_ROOT=/srv/videocut/oss-local
OSS_LOCAL_ROOT=

# -------------------------------------------------------------------------------
# BGM sync
# -------------------------------------------------------------------------------

# Sync public and backup BGM assets from OSS before the service starts.
SYNC_BGM_ON_STARTUP=1

# Sync hidden template BGM assets from OSS before the service starts.
# This is a full incremental sync: unchanged local files are skipped with ossutil -u.
SYNC_BGM_TEMPLATE_ON_STARTUP=1

# In-container BGM directory. The app also uses this as the default lookup path.
BGM_DIR=/app/input/bgm

# OSS source path for background music assets.
BGM_OSS_URI=oss://goumee-coze/GouMei-Video-Cut/bgm/

# In-container archive directory for hidden legacy BGM fallback.
BGM_BACKUP_DIR=/app/input/bgm-backup

# OSS source path for hidden legacy BGM assets. Keep the same category/file layout as BGM_OSS_URI.
BGM_BACKUP_OSS_URI=oss://goumee-coze/GouMei-Video-Cut/bgm-backup/

# Hidden template BGM directory. It is not returned by GET /bgm.
BGM_TEMPLATE_DIR=/app/input/bgm-templete

# OSS source path for backend-managed template BGM assets.
BGM_TEMPLATE_OSS_URI=oss://goumee-coze/GouMei-Video-Cut/bgm-templete/

# Timeout for POST /admin/bgm-template/sync.
BGM_TEMPLATE_SYNC_TIMEOUT_SECONDS=600

# ------------------------------------------------------------------------------
# Queue / worker tuning
# ------------------------------------------------------------------------------

# 0 means auto: max(1, cpu_count // 2).
# Set an explicit value in containers if you want predictable concurrency.
WORKER_COUNT=0

# Maximum number of queued tasks waiting for workers.
QUEUE_MAX=200

# Maximum retry count after worker/render failure.
TASK_MAX_ATTEMPT=3

# Output uploads run outside render workers so the next render can start immediately.
UPLOAD_WORKER_COUNT=2

# Maximum retry count for completed render output upload.
UPLOAD_MAX_ATTEMPT=3

# How many days completed / failed task records are kept in SQLite.
TASK_TTL_DAYS=7

# ------------------------------------------------------------------------------
# Runtime paths inside container
# ------------------------------------------------------------------------------

# Persistent SQLite database path.
DB_PATH=/srv/videocut/data/tasks.db

# Temporary upload / worker workspace directory.
TEMP_DIR=/srv/videocut/temp
