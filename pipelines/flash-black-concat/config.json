{
  "name": "flash-black-concat",
  "mode": "pipeline",
  "preset": "auto",
  "quality": "high",
  "bgm": {
    "enabled": true,
    "dir": "input/bgm",
    "volume": 1,
    "fade_out": 0
  },
  "clips": [
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 }
  ],
  "default_transition": { "type": "flash-black", "duration": 0.5 },
  "variables": {
    "transition_duration": {
      "type": "number",
      "required": false,
      "default": 0.5,
      "min": 0.1,
      "max": 2.0
    }
  },
  "overridable": ["transition_duration"]
}
