{
  "name": "subtitle-burn",
  "mode": "pipeline",
  "required_clip_count": 1,
  "preset": "auto",
  "quality": "high",
  "clips": [
    {
      "source_index": 0,
      "trim_start": 0,
      "trim_end": 0
    }
  ],
  "default_transition": {
    "type": "cut",
    "duration": 0
  },
  "subtitle": {
    "enabled": true,
    "definition": 122,
    "target_language": "auto",
    "language_mode": "source",
    "accurate_mode": true,
    "need_wordlist": false,
    "adapt_words": "",
    "font_name": "msyh.ttc",
    "font_size": 40,
    "font_color": "#FFFFFF",
    "font_alpha": 0.9,
    "position": "bottom",
    "auto_wrap": true,
    "max_chars_per_line": 16
  }
}
