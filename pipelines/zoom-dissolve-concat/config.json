{
  "name": "zoom-dissolve-concat",
  "mode": "pipeline",
  "preset": "auto",
  "quality": "high",
  "clips": [
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 },
    { "trim_start": 0, "trim_end": 0 }
  ],
  "default_transition": { "type": "zoom-dissolve", "duration": 0.4, "scale": 1.18 },
  "variables": {
    "transition_duration": {
      "type": "number",
      "required": false,
      "default": 0.4,
      "min": 0.1,
      "max": 3.0
    },
    "zoom_scale": {
      "type": "number",
      "required": false,
      "default": 1.18,
      "min": 1.05,
      "max": 2.0
    }
  },
  "overridable": ["transition_duration", "zoom_scale"]
}
