{
  "name": "bgm-concat",
  "mode": "pipeline",
  "preset": "auto",
  "quality": "high",
  "bgm": {
    "enabled": true,
    "dir": "input/bgm",
    "volume": 1,
    "fade_out": 0
  },
  "clips": [
    { "trim_start": 0, "trim_end": 0 }
  ],
  "default_transition": {
    "type": "cut",
    "duration": 0
  }
}
